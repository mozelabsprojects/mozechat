rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı Fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomMember(roomId) {
      return request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    match /users/{userId} {
      // Kullanıcı verilerine sadece oturum açanlar erişebilir
      allow read: if isAuthenticated();
      // Yalnızca kullanıcının kendisi kendi dökümanını yazabilir
      allow write: if isAuthenticated() && request.auth.uid == userId;
      
      // Kullanıcının alt koleksiyonlarındaki odalar
      match /rooms/{roomId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /rooms/{roomId} {
      // Odayı sorgulamak (get) herkes için açık olmalı ki oda var mı yok mu kontrol edilebilsin
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (request.auth.uid in resource.data.members);
      
      // Oda oluşturmaya izin ver
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.members);
      
      // Odayı güncellemeye izin ver:
      // 1. Zaten oda üyesiyse güncelleme serbest
      // 2. Yeni katılıyorsa: oda kapasitesi dolmamış olmalı (< 2) ve mevcut üyeler korunmalı
      allow update: if isAuthenticated() && (
        (request.auth.uid in resource.data.members) || 
        (
          resource.data.members.size() < 2 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          (request.auth.uid in request.resource.data.members)
        )
      );
      
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.members);
      
      // Mesajlara yalnızca oda üyeleri erişebilir
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && isRoomMember(roomId);
      }
      
      // Aramalara (WebRTC) yalnızca oda üyeleri erişebilir
      match /calls/{callId} {
        allow read, write: if isAuthenticated() && isRoomMember(roomId);
        
        match /{document=**} {
          allow read, write: if isAuthenticated() && isRoomMember(roomId);
        }
      }
    }
  }
}
